  "components": {
    "schemas": {
      "LoginUserDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshTokenRequestDTO": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "ResponseDTO": {
        "type": "object",
        "properties": {
          "success": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "data": { }
        }
      },
      "UserModelDTO": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,}$",
            "type": "string"
          },
          "dob": {
            "type": "string",
            "format": "date"
          },
          "registeredDate": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  },
